	<string>FIT puede avisarte cuando termina tu descanso aunque el iPhone esté bloqueado. Las alarmas son opcionales.</string>
	<key>NSMotionUsageDescription</key>
	<string>FIT muestra tus pasos de hoy en la pantalla Hoy.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Fonts/Archivo-Regular.ttf</string>
		<string>Fonts/Archivo-Medium.ttf</string>
		<string>Fonts/Archivo-SemiBold.ttf</string>
		<string>Fonts/Archivo-Bold.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
